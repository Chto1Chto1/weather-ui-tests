    {
      "name": "04 Forecast — текущая температура (без API-ключа)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Есть текущая температура в °C\", function () { const b = pm.response.json(); pm.expect(b.current.temperature_2m).to.be.a(\"number\"); pm.expect(b.current_units.temperature_2m).to.eql(\"°C\"); });",
              "pm.test(\"Время ответа меньше 2000 мс\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{forecast_url}}?latitude=55.7558&longitude=37.6173&current=temperature_2m",
          "host": [
            "{{forecast_url}}"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "55.7558"
            },
            {
              "key": "longitude",
              "value": "37.6173"
            },
            {
              "key": "current",
              "value": "temperature_2m"
            }
          ]
        }
      }
    },
