  "item": [
    {
      "name": "01 Geocoding — поиск города Moscow",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Найден город с координатами\", function () { const b = pm.response.json(); pm.expect(b.results).to.be.an(\"array\").that.is.not.empty; pm.expect(b.results[0].latitude).to.be.a(\"number\"); pm.expect(b.results[0].longitude).to.be.a(\"number\"); });",
              "pm.test(\"Время ответа меньше 2000 мс\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{geo_url}}?name=Moscow&count=1&language=ru&format=json",
          "host": [
            "{{geo_url}}"
          ],
          "query": [
            {
              "key": "name",
              "value": "Moscow"
            },
            {
              "key": "count",
              "value": "1"
            },
            {
              "key": "language",
              "value": "ru"
            },
            {
              "key": "format",
              "value": "json"
            }
          ]
        }
      }
    },
    {
